---
import site from '../data/site.json';
---
<div class="course-filter" hidden>
  <label>
    <span>{site.courseFilterLabel.replace('{semester}', site.semester)}</span>
    <input class="sr-only" type="checkbox" role="switch" />
    <span class="filter-switch" aria-hidden="true"></span>
  </label>
</div>
<p class="course-filter-empty muted" hidden>{site.courseFilterEmptyMessage}</p>
<span class="sr-only" data-course-filter-status role="status" aria-live="polite"></span>

<style>
  .course-filter { width: fit-content; max-width: 100%; margin: 20px 0 0 auto; font-size: 14px; }
  .course-filter[hidden] { display: none; }
  .course-filter label { display: flex; align-items: center; gap: 9px; min-height: 32px; cursor: pointer; }
  .filter-switch { position: relative; flex: 0 0 36px; width: 36px; height: 22px; border-radius: 11px; background: #888; }
  .filter-switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 18px; height: 18px; border-radius: 50%; background: white; box-shadow: 0 1px 3px rgb(0 0 0 / 18%); }
  input:checked + .filter-switch { background: #2585e9; }
  input:checked + .filter-switch::after { transform: translateX(14px); }
  input:focus-visible + .filter-switch { outline: 2px solid #555; outline-offset: 3px; }
  .course-filter-empty { margin-top: 24px; }
</style>

<script>
  const section = document.getElementById('courses');
  const filter = section?.querySelector<HTMLElement>('.course-filter');
  if (section && filter) {
    const groups = Array.from(section.querySelectorAll<HTMLElement>('.course-group'));
    const empty = section.querySelector<HTMLElement>('.course-filter-empty')!;
    const status = section.querySelector<HTMLElement>('[data-course-filter-status]')!;
    filter.hidden = false;
    filter.addEventListener('change', () => {
      const running = filter.querySelector<HTMLInputElement>('input')!.checked;
      section.dataset.courseFilter = running ? 'running' : 'all';
      let shown = 0;
      groups.forEach(group => {
        const rows = group.querySelectorAll(running ? '[data-course-row][data-course-running="true"]' : '[data-course-row]');
        shown += rows.length;
        group.hidden = rows.length === 0;
      });
      empty.hidden = shown > 0;
      status.textContent = `${shown} ${shown === 1 ? 'course' : 'courses'} shown.`;
    });
  }
</script>
